def load_protocol(path=None):
    """Return the embedded settings, or explicitly supplied replacement settings."""
    if path is None:
        return json.loads(json.dumps(PROTOCOL))
    return json.loads(Path(path).read_text(encoding="utf-8"))


def _load_table(path, identifier, extra_columns):
    frame = pd.read_csv(path, float_precision="round_trip")
    required = [identifier, *RAW_FEATURES, *extra_columns]
    missing = set(required) - set(frame.columns)
    if missing:
        raise ValueError(f"Missing columns in {path}: {sorted(missing)}")
    if frame[identifier].isna().any() or frame[identifier].duplicated().any():
        raise ValueError(f"{identifier} must be nonmissing and unique")
    numeric = frame[RAW_FEATURES + (["output"] if "output" in extra_columns else [])]
    if not np.isfinite(numeric.to_numpy(dtype=float)).all():
        raise ValueError(f"Nonfinite numeric data in {path}")
    frame["delta_side"] = frame["f-_side"] - frame["f+_side"]
    return frame


def load_training(path=None):
    """Load measured open-circuit voltages in V without rounding or normalization."""
    source = StringIO(TRAINING_CSV) if path is None else path
    frame = _load_table(source, "AA", ["output"])
    return frame


def load_descriptor_table(path):
    """Load a user-supplied descriptor table with a unique ID column."""
    frame = _load_table(path, "ID", [])
    if frame.empty:
        raise ValueError("The descriptor table must contain at least one row")
    return frame


def make_model(params=None):
    """Fit standardization only on the data passed to Pipeline.fit."""
    pipe = Pipeline([
        ("scaler", StandardScaler()),
        ("svr", SVR(kernel="rbf")),
    ])
    if params:
        pipe.set_params(**params)
    return pipe


def regression_metrics(observed, predicted):
    """Use pooled, untrimmed voltages: R2 is dimensionless; MAE and RMSE are in V."""
    return {
        "R2": float(r2_score(observed, predicted)),
        "MAE": float(mean_absolute_error(observed, predicted)),
        "RMSE": float(np.sqrt(mean_squared_error(observed, predicted))),
    }


def tune_model(X, y, param_grid, jobs=1):
    search = GridSearchCV(
        make_model(), param_grid, cv=LeaveOneOut(),
        scoring="neg_mean_squared_error", n_jobs=jobs, error_score="raise",
    )
    search.fit(X, y)
    return search


def evaluate_exploratory(frame, protocol, jobs=1):
    """Select sets and parameters on the same LOOCV predictions; exploratory."""
    y = frame["output"].to_numpy()
    records, fitted = [], {}
    for name, features in protocol["feature_sets"].items():
        X = frame[features].to_numpy()
        search = tune_model(X, y, protocol["param_grid"], jobs)
        predicted = cross_val_predict(
            search.best_estimator_, X, y, cv=LeaveOneOut(), n_jobs=jobs
        )
        model = search.best_estimator_
        scores = regression_metrics(y, predicted)
        fit_scores = regression_metrics(y, model.predict(X))
        records.append({
            "feature_set": name,
            "features": json.dumps(features),
            "best_params": json.dumps(search.best_params_, sort_keys=True),
            **scores,
            **{f"Fit_{key}": value for key, value in fit_scores.items()},
        })
        fitted[name] = {
            "model": model, "features": features, "params": search.best_params_,
            "predicted": predicted, "metrics": scores,
        }
    # First-in-order selection makes exact ties deterministic.
    best_name = max(fitted, key=lambda name: fitted[name]["metrics"]["R2"])
    return pd.DataFrame(records), fitted, best_name


def save_metadata(output_dir, inputs, settings):
    """Record embedded or supplied input hashes, script hash and software versions."""
    input_hashes = {}
    for name, path in inputs.items():
        if path is not None:
            content = Path(path).read_bytes()
        elif name == "training":
            content = TRAINING_CSV.encode("utf-8")
        elif name == "protocol":
            content = json.dumps(PROTOCOL, sort_keys=True).encode("utf-8")
        else:
            raise ValueError(f"No input supplied for {name}")
        input_hashes[name] = hashlib.sha256(content).hexdigest()
    packages = ("numpy", "pandas", "scipy", "scikit-learn", "joblib", "threadpoolctl")
    payload = {
        "python": platform.python_version(),
        "packages": {name: importlib.metadata.version(name) for name in packages},
        "input_sha256": input_hashes,
        "script_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "settings": settings,
    }
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / "run_metadata.json").write_text(
        json.dumps(payload, indent=2, allow_nan=False) + "\n", encoding="utf-8"
    )


def _compare_models(models, X, y, jobs):
    records, predictions = [], {}
    for name, model in models.items():
        predicted = cross_val_predict(model, X, y, cv=LeaveOneOut(), n_jobs=jobs)
        model.fit(X, y)
        records.append({
            "model": name, **regression_metrics(y, predicted),
            **{f"Fit_{key}": value
               for key, value in regression_metrics(y, model.predict(X)).items()},
        })
        predictions[name] = predicted
    return pd.DataFrame(records), predictions


def _save_pca(frame, protocol, output_dir):
    """Export ordinary PCA and a separate response-informed exploratory embedding.

    Ordinary PCA uses all nine standardized descriptors without response weights.
    It is not asserted to reproduce Fig. 3h/i until the figure workflow is confirmed.
    """
    y = frame["output"].to_numpy()
    scaled = StandardScaler().fit_transform(frame[RAW_FEATURES])
    pca = PCA(n_components=2)
    scores = pca.fit_transform(scaled)
    pd.DataFrame({"AA": frame["AA"], "PC1": scores[:, 0],
                  "PC2": scores[:, 1], "output": y}).to_csv(
        output_dir / "pca_scores.csv", index=False
    )
    loadings = pd.DataFrame(pca.components_.T, index=RAW_FEATURES,
                            columns=["PC1_loading", "PC2_loading"])
    loadings["loading_norm_2D"] = np.linalg.norm(pca.components_.T, axis=1)
    loadings.to_csv(output_dir / "pca_loadings.csv", index_label="feature")
    pd.DataFrame({"component": ["PC1", "PC2"],
                  "explained_variance_ratio": pca.explained_variance_ratio_}).to_csv(
        output_dir / "pca_explained_variance.csv", index=False
    )

    # Response-informed PCA is an exploratory visualization, not validation.
    bins = pd.qcut(frame["output"], q=4, labels=False, duplicates="drop")
    sets = {name: protocol["feature_sets"][name]
            for name in ("compact_5", "core_4", "all_9", "contrast_5")}
    rows, best = [], None
    for name, features in sets.items():
        X = frame[features].to_numpy()
        X_scaled = StandardScaler().fit_transform(X)
        weights_base = np.abs([np.corrcoef(X[:, j], y)[0, 1]
                               for j in range(X.shape[1])])
        weights_base = np.nan_to_num(weights_base)
        for alpha in [0.0, 0.5, 1.0, 1.5, 2.0, 3.0]:
            weights = np.where(weights_base == 0, 1e-6, weights_base) ** alpha
            pca = PCA(n_components=2)
            scores = pca.fit_transform(X_scaled * weights)
            pc1_corr = abs(np.corrcoef(scores[:, 0], y)[0, 1])
            pc2_corr = abs(np.corrcoef(scores[:, 1], y)[0, 1])
            separation = silhouette_score(scores, bins)
            row = {
                "feature_set": name, "alpha": alpha,
                "silhouette_output_bins": separation,
                "abs_corr_PC1_output": pc1_corr, "abs_corr_PC2_output": pc2_corr,
                "combined_score": 0.7 * separation + 0.3 * (pc1_corr + pc2_corr),
                "explained_var_PC1": pca.explained_variance_ratio_[0],
                "explained_var_PC2": pca.explained_variance_ratio_[1],
            }
            rows.append(row)
            if best is None or row["combined_score"] > best["row"]["combined_score"]:
                best = {"row": row, "scores": scores.copy(), "pca": pca,
                        "features": features, "weights": weights.copy()}
    pd.DataFrame(rows).to_csv(output_dir / "weighted_pca_search.csv", index=False)
    pd.DataFrame({"AA": frame["AA"], "PC1": best["scores"][:, 0],
                  "PC2": best["scores"][:, 1], "output": y,
                  "output_bin": bins}).to_csv(output_dir / "weighted_pca_scores.csv", index=False)
    pd.DataFrame({"feature": best["features"], "weight": best["weights"],
                  "PC1_loading": best["pca"].components_[0],
                  "PC2_loading": best["pca"].components_[1]}).to_csv(
        output_dir / "weighted_pca_loadings.csv", index=False
    )


def run_analysis(training_path, protocol_path, output_dir, jobs):
    frame = load_training(training_path)
    protocol = load_protocol(protocol_path)
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    summary, fitted, best = evaluate_exploratory(frame, protocol, jobs)
    summary.to_csv(output_dir / "descriptor_set_comparison.csv", index=False)
    info = fitted[best]
    X, y = frame[info["features"]].to_numpy(), frame["output"].to_numpy()

    def scaled(estimator):
        return Pipeline([("scaler", StandardScaler()), ("model", estimator)])

    models = {
        "Linear": scaled(LinearRegression()),
        "Ridge": scaled(Ridge(alpha=1.0)),
        "GPR": scaled(GaussianProcessRegressor(normalize_y=True, random_state=42)),
        "SVR_RBF": info["model"],
    }
    # Comparisons are conditional on these configurations and tuning budgets.
    # GPR's normalize_y is internal preprocessing; it does not redefine output units.
    comparison, predictions = _compare_models(models, X, y, jobs)
    comparison.to_csv(output_dir / "model_comparison.csv", index=False)
    pd.DataFrame({"AA": frame["AA"], "observed": y, **predictions}).to_csv(
        output_dir / "model_loocv_predictions.csv", index=False
    )
    params = info["params"]
    C, epsilon = params["svr__C"], params["svr__epsilon"]
    kernels = {
        "SVR_linear": scaled(SVR(kernel="linear", C=C, epsilon=epsilon)),
        "SVR_poly": scaled(SVR(kernel="poly", C=C, epsilon=epsilon,
                               gamma="scale", degree=3, coef0=0.0)),
        "SVR_rbf": info["model"],
        "SVR_sigmoid": scaled(SVR(kernel="sigmoid", C=C, epsilon=epsilon,
                                  gamma="scale", coef0=0.0)),
    }
    kernel_comparison, kernel_predictions = _compare_models(kernels, X, y, jobs)
    kernel_comparison.to_csv(output_dir / "kernel_comparison.csv", index=False)
    pd.DataFrame({"AA": frame["AA"], "observed": y, **kernel_predictions}).to_csv(
        output_dir / "kernel_loocv_predictions.csv", index=False
    )
    model = info["model"]
    model.fit(X, y)
    importance = permutation_importance(
        model, X, y, n_repeats=100, random_state=42, scoring="neg_mean_squared_error"
    )
    # Training-set importance measures model dependence, not physical causation.
    # With a negative-MSE score, importance and its SD have units of V squared.
    pd.DataFrame({"feature": info["features"],
                  "importance_mean": importance.importances_mean,
                  "importance_std": importance.importances_std}).sort_values(
        "importance_mean", ascending=False
    ).to_csv(output_dir / "permutation_importance.csv", index=False)
    frame[RAW_FEATURES + ["output"]].corr(method="pearson").to_csv(
        output_dir / "pearson_correlations.csv", index_label="variable"
    )
    _save_pca(frame, protocol, output_dir)
    save_metadata(output_dir, {"training": training_path, "protocol": protocol_path}, {
        "analysis": "exploratory", "jobs": jobs, "selected_set": best,
        "selected_parameters": params,
        "permutation_importance": {"repeats": 100, "seed": 42, "evaluation": "training"},
        "weighted_pca": "response-informed exploratory visualization",
    })
    print("Exploratory non-nested LOOCV")
    print(summary.to_string(index=False))
    print("Selected set:", best, "Parameters:", params)


def _inner_mse_for_parameter(X, y, pairs, params):
    """Return inner-LOOCV MSE for each possible outer holdout.

    For holdouts i and j, the training set excludes both observations.
    One deterministic fit therefore serves outer=i/inner=j and outer=j/inner=i.
    Predictions and errors remain separate for the two folds.
    """
    n = len(y)
    squared_errors = np.zeros((n, n))
    for i, j, train in pairs:
        model = make_model(params).fit(X[train], y[train])
        predicted = model.predict(X[[i, j]])
        squared_errors[i, j] = (predicted[1] - y[j]) ** 2
        squared_errors[j, i] = (predicted[0] - y[i]) ** 2
    return squared_errors.sum(axis=1) / (n - 1)


def nested_loocv(frame, protocol, jobs=1, progress=None):
    """Select descriptors and parameters using outer-training observations only.

    A second prediction in each fold conditions on the protocol's fixed feature
    set and selects only its hyperparameters in the inner loop.
    """
    if len(frame) < 4:
        raise ValueError("Nested LOOCV requires at least four observations")
    y = frame["output"].to_numpy()
    names = frame["AA"].to_numpy()
    n = len(frame)
    parameters = list(ParameterGrid(protocol["param_grid"]))
    fixed = protocol["fixed_feature_set"]
    indices = np.arange(n)
    pairs = [(i, j, indices[(indices != i) & (indices != j)])
             for i, j in combinations(range(n), 2)]
    matrices = {name: frame[features].to_numpy()
                for name, features in protocol["feature_sets"].items()}
    if fixed not in matrices:
        raise ValueError("The fixed feature set must be a candidate feature set")
    inner_scores = {}
    for name, X in matrices.items():
        inner_scores[name] = np.asarray(Parallel(n_jobs=jobs)(
            delayed(_inner_mse_for_parameter)(X, y, pairs, params)
            for params in parameters
        ))
        if progress:
            progress(f"N={n}: inner LOOCV complete for {name}")

    folds = []
    for outer in range(n):
        train = indices[indices != outer]
        choices = []
        for name in matrices:
            parameter_index = int(np.argmin(inner_scores[name][:, outer]))
            choices.append((float(inner_scores[name][parameter_index, outer]),
                            name, parameter_index))
        selected_mse, selected, selected_index = min(choices, key=lambda item: item[0])
        params = parameters[selected_index]
        X = matrices[selected]
        predicted = make_model(params).fit(X[train], y[train]).predict(X[[outer]])[0]

        fixed_index = int(np.argmin(inner_scores[fixed][:, outer]))
        fixed_params = parameters[fixed_index]
        X_fixed = matrices[fixed]
        fixed_predicted = make_model(fixed_params).fit(
            X_fixed[train], y[train]
        ).predict(X_fixed[[outer]])[0]
        folds.append({
            "AA": names[outer], "observed": float(y[outer]),
            "predicted": float(predicted), "selected_set": selected,
            "selected_features": json.dumps(protocol["feature_sets"][selected]),
            "selected_params": json.dumps(params, sort_keys=True),
            "selected_inner_MSE": selected_mse,
            "fixed5_predicted": float(fixed_predicted),
            "fixed5_params": json.dumps(fixed_params, sort_keys=True),
            "fixed5_inner_MSE": float(inner_scores[fixed][fixed_index, outer]),
        })
    predictions = pd.DataFrame(folds)
    scores = {
        "nested_reselection": regression_metrics(y, predictions["predicted"]),
        "nested_fixed5": regression_metrics(y, predictions["fixed5_predicted"]),
    }
    return predictions, scores


def run_validation(training_path, protocol_path, output_dir, jobs):
    frame = load_training(training_path)
    protocol = load_protocol(protocol_path)
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    exclusions = protocol["sensitivity_exclusions"]
    if not set(exclusions).issubset(set(frame["AA"])):
        raise ValueError("Sensitivity exclusions are missing from the training table")
    populations = {
        "full20": frame,
        "subset17": frame.loc[~frame["AA"].isin(exclusions)].reset_index(drop=True),
    }
    summaries, counts = [], []
    for population, sample in populations.items():
        candidates, fitted, best = evaluate_exploratory(sample, protocol, jobs)
        candidates.to_csv(output_dir / f"{population}_exploratory_candidates.csv", index=False)
        fixed = protocol["fixed_feature_set"]
        kinds = {"nonnested_reselection": best}
        if population == "subset17":
            kinds["nonnested_fixed5"] = fixed
        for analysis, selected in kinds.items():
            info = fitted[selected]
            summaries.append({"population": population, "n": len(sample),
                              "analysis": analysis, "feature_set": selected,
                              **info["metrics"]})
            pd.DataFrame({
                "AA": sample["AA"], "observed": sample["output"],
                "predicted": info["predicted"],
            }).to_csv(output_dir / f"{population}_{analysis}_predictions.csv", index=False)

        predictions, scores = nested_loocv(
            sample, protocol, jobs, progress=lambda msg: print(msg, flush=True)
        )
        predictions.to_csv(output_dir / f"{population}_nested_predictions.csv", index=False)
        summaries.append({"population": population, "n": len(sample),
                          "analysis": "nested_reselection", "feature_set": "inner_selection",
                          **scores["nested_reselection"]})
        if population == "subset17":
            summaries.append({"population": population, "n": len(sample),
                              "analysis": "nested_fixed5", "feature_set": fixed,
                              **scores["nested_fixed5"]})
        frequencies = Counter(predictions["selected_set"])
        counts.extend({"population": population, "feature_set": name,
                       "selected_folds": frequencies[name], "outer_folds": len(sample)}
                      for name in protocol["feature_sets"])

    summary = pd.DataFrame(summaries)
    order = [
        ("full20", "nonnested_reselection"), ("full20", "nested_reselection"),
        ("subset17", "nested_reselection"), ("subset17", "nested_fixed5"),
        ("subset17", "nonnested_reselection"), ("subset17", "nonnested_fixed5"),
    ]
    summary = summary.set_index(["population", "analysis"]).loc[order].reset_index()
    summary.to_csv(output_dir / "validation_summary.csv", index=False)
    pd.DataFrame(counts).to_csv(output_dir / "descriptor_selection_frequency.csv", index=False)
    save_metadata(output_dir, {"training": training_path, "protocol": protocol_path}, {
        "analysis": "validation", "jobs": jobs, "subset_defined_post_hoc": True,
        "excluded_from_subset": exclusions, "predictions_clipped_for_metrics": False,
    })
    print(summary.to_string(index=False, float_format=lambda value: f"{value:.10f}"))
    return summary


def pps_components(prediction, bootstrap_sd, distance,
                   uncertainty_weight=5.0, distance_weight=0.8):
    """Return the three score factors and their product, on a 0-100 scale.

    Prediction and bootstrap SD are in V; SD uses ddof=0. Distance is the
    dimensionless Euclidean distance to the nearest standardized training vector,
    not a chain-extension count or necessarily distance to a parent molecule.
    The output factor is clip(prediction / (1 V), 0, 1). The uncertainty weight
    5 has units V^-1; the distance weight 0.8 is dimensionless. These are heuristic
    scoring settings. Only the score factor is clipped; voltages are unchanged.
    """
    prediction, bootstrap_sd, distance = np.broadcast_arrays(
        np.asarray(prediction, dtype=float),
        np.asarray(bootstrap_sd, dtype=float),
        np.asarray(distance, dtype=float),
    )
    if any(not np.isfinite(x).all() for x in (prediction, bootstrap_sd, distance)):
        raise ValueError("PPS inputs must be finite")
    if (bootstrap_sd < 0).any() or (distance < 0).any():
        raise ValueError("Bootstrap SD and distance must be nonnegative")
    weights = np.asarray([uncertainty_weight, distance_weight], dtype=float)
    if not np.isfinite(weights).all() or (weights < 0).any():
        raise ValueError("PPS weights must be finite and nonnegative")
    output_factor = np.clip(prediction / PPS_REFERENCE_V, 0.0, 1.0)
    uncertainty_factor = 1.0 / (1.0 + uncertainty_weight * bootstrap_sd)
    distance_factor = 1.0 / (1.0 + distance_weight * distance)
    return {
        "S_output": output_factor,
        "S_uncertainty": uncertainty_factor,
        "S_domain": distance_factor,
        "PPS": 100.0 * output_factor * uncertainty_factor * distance_factor,
    }


def score_table(frame, settings):
    """Score rows without changing their input values or order."""
    missing = set(("predicted_output", "pred_std_boot", "distance_to_training")) - set(frame.columns)
    if missing:
        raise ValueError(f"Missing PPS input columns: {sorted(missing)}")
    result = frame.copy()
    components = pps_components(
        *[frame[column].to_numpy(dtype=float) for column in ("predicted_output", "pred_std_boot", "distance_to_training")],
        uncertainty_weight=settings["uncertainty_weight"],
        distance_weight=settings["distance_weight"],
    )
    for column, values in components.items():
        result[column] = values
    return result


def bootstrap_predictions(X, y, X_new, params, resamples, seed):
    """Refit scaler and SVR with fixed selected settings; return voltages in V.

    Percentiles of these resampled predictions describe conditional model
    variability, not 95% coverage guarantees for new experimental measurements.
    Predictions and bootstrap percentiles are not clipped.
    """
    if resamples < 2:
        raise ValueError("At least two bootstrap resamples are required")
    rng = np.random.default_rng(seed)
    predictions = []
    for _ in range(resamples):
        indices = rng.choice(np.arange(len(y)), size=len(y), replace=True)
        model = make_model(params).fit(X[indices], y[indices])
        predictions.append(model.predict(X_new))
    return np.asarray(predictions)


def nearest_training_distance(model, X, X_new):
    """Return nearest row indices and Euclidean distances in scaled feature space."""
    scaler = model.named_steps["scaler"]
    training = scaler.transform(X)
    supplied = scaler.transform(X_new)
    distances = np.linalg.norm(supplied[:, None, :] - training[None, :, :], axis=2)
    nearest = np.argmin(distances, axis=1)
    return nearest, distances[np.arange(len(supplied)), nearest]


def screen_by_uncertainty_and_distance(frame):
    """Keep SD < 0.15 V and distance < 0.8; rank by predicted voltage, not PPS."""
    keep = ((frame["pred_std_boot"] < BOOTSTRAP_SD_LIMIT)
            & (frame["distance_to_training"] < TRAINING_DISTANCE_LIMIT))
    return frame.loc[keep].sort_values(
        "predicted_output", ascending=False, kind="stable"
    ).copy()


def run_prediction(training_path, descriptor_path, protocol_path, output_dir, jobs):
    training = load_training(training_path)
    supplied = load_descriptor_table(descriptor_path)
    protocol = load_protocol(protocol_path)
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    comparison, fitted, best = evaluate_exploratory(training, protocol, jobs)
    comparison.to_csv(output_dir / "descriptor_set_comparison.csv", index=False)
    info = fitted[best]
    X = training[info["features"]].to_numpy()
    X_new = supplied[info["features"]].to_numpy()
    y = training["output"].to_numpy()
    model = info["model"].fit(X, y)
    result = pd.DataFrame({"ID": supplied["ID"],
                           "predicted_output": model.predict(X_new)})

    settings = protocol["bootstrap"]
    bootstrap = bootstrap_predictions(
        X, y, X_new, info["params"], settings["resamples"], settings["random_seed"]
    )
    result["pred_mean_boot"] = bootstrap.mean(axis=0)
    result["pred_std_boot"] = bootstrap.std(axis=0, ddof=0)
    # Conditional bootstrap quantiles in V, without experimental coverage guarantees.
    result["pred_ci95_low"] = np.percentile(bootstrap, 2.5, axis=0)
    result["pred_ci95_high"] = np.percentile(bootstrap, 97.5, axis=0)
    result["n_bootstrap"] = len(bootstrap)
    nearest, distances = nearest_training_distance(model, X, X_new)
    result["nearest_training_AA"] = training["AA"].to_numpy()[nearest]
    result["distance_to_training"] = distances
    result = score_table(result, protocol["pps"])
    result.to_csv(output_dir / "predictions.csv", index=False)
    result.sort_values("PPS", ascending=False, kind="stable").to_csv(
        output_dir / "pps_ranking.csv", index=False
    )
    screen_by_uncertainty_and_distance(result).to_csv(
        output_dir / "screened_prediction_ranking.csv", index=False
    )
    bootstrap_table = pd.DataFrame(bootstrap, columns=supplied["ID"])
    bootstrap_table.insert(0, "bootstrap_id", np.arange(1, len(bootstrap) + 1))
    bootstrap_table.to_csv(output_dir / "bootstrap_predictions.csv", index=False)
    save_metadata(output_dir, {
        "training": training_path, "supplied_descriptors": descriptor_path,
        "protocol": protocol_path,
    }, {
        "analysis": "user_supplied_predictions", "jobs": jobs,
        "selected_set": best, "selected_parameters": info["params"],
        "bootstrap": settings, "bootstrap_hyperparameters_fixed": True,
        "pps": protocol["pps"],
        "screening": {"bootstrap_sd_strict_upper_limit": BOOTSTRAP_SD_LIMIT,
                      "nearest_distance_strict_upper_limit": TRAINING_DISTANCE_LIMIT,
                      "rank_by": "predicted_output"},
    })
    print("Selected set:", best, "Parameters:", info["params"])
    print(result.to_string(index=False))
    return result


def run_pps(input_path, output_dir):
    """Compute PPS for a user-supplied prediction/uncertainty/distance table."""
    frame = pd.read_csv(input_path, float_precision="round_trip")
    if frame.empty:
        raise ValueError("The input table must contain at least one row")
    settings = load_protocol()["pps"]
    result = score_table(frame, settings)
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    result.to_csv(output_dir / "pps_scores.csv", index=False)
    result.sort_values("PPS", ascending=False, kind="stable").to_csv(
        output_dir / "pps_ranking.csv", index=False
    )
    save_metadata(output_dir, {"score_inputs": input_path, "protocol": None},
                  {"analysis": "pps_calculation", "pps": settings})
    print(result.to_string(index=False))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=["analysis", "validation", "all", "predict", "pps"],
                        default="analysis", help="Default: exploratory amino-acid analysis")
    parser.add_argument("--input", type=Path,
                        help="External descriptor or PPS-input CSV; required for predict/pps")
    parser.add_argument("--output-dir", type=Path, default=Path("results"))
    parser.add_argument("--jobs", type=int, default=1)
    args = parser.parse_args()
    if args.jobs == 0:
        parser.error("--jobs cannot be zero")
    if args.mode in ("predict", "pps") and args.input is None:
        parser.error("--input is required for predict and pps modes")
    if args.input is not None and args.mode not in ("predict", "pps"):
        parser.error("--input is used only by predict and pps modes")
    if args.mode in ("analysis", "all"):
        run_analysis(None, None, args.output_dir / "analysis", args.jobs)
    if args.mode in ("validation", "all"):
        run_validation(None, None, args.output_dir / "validation", args.jobs)
    if args.mode == "predict":
        run_prediction(None, args.input, None, args.output_dir / "prediction", args.jobs)
    if args.mode == "pps":
        run_pps(args.input, args.output_dir / "pps")


if __name__ == "__main__":
    main()
